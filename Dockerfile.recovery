FROM python:3.12-slim AS prepare
WORKDIR /build
COPY dist ./brand
COPY recovery-prefix-brand.py ./
RUN python recovery-prefix-brand.py
FROM nginx:stable-alpine
COPY recovery-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=prepare /build/brand /usr/share/nginx/html/brand
COPY recovery-site /usr/share/nginx/html
EXPOSE 8080
